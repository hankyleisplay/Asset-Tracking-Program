{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asset Tracking Program",
  "version": "2.0.0",
  "identifier": "com.hankyle.assettracking",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "資產與證券追蹤系統 v2.0 (Asset & Portfolio Tracking)",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
